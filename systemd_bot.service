[Unit]
Description=GUAP Coursework Var 18 Telegram Task & Monitoring Bot
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/coursework_var18_bot
EnvironmentFile=/opt/coursework_var18_bot/.env
ExecStart=/opt/coursework_var18_bot/venv/bin/python -m src.main
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
